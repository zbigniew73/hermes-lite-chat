HERMES_HOME=~/.hermes
HERMES_BIN=hermes
HOST=0.0.0.0
PORT=8000
# RELOAD=true   # uncomment for dev auto-reload on file changes

# Bootstrap-only login (HTTP Basic Auth). Only used the very first time the
# app runs (no ~/.config/hermes-lite-chat/auth.json yet) — change the
# password from the app itself afterwards; editing these later has no effect.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pass123!
